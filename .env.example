# Copy to .env and fill in only when a live model call is intentionally enabled.
# Never commit .env. Demo mode runs without these values.

# Model host key. Used for photograph analysis and for text recommendations.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Optional. When empty, the backend picks an image-capable model and a text
# model from GET /v1/models. A text model is not sent an image unless that
# catalog entry lists image input.
NEBIUS_VISION_MODEL=
NEBIUS_REASONING_MODEL=

# Leave empty. Choose the ESP32 COM port from the field page.
# Example after you confirm it in Device Manager: COM5
RUBBLEECHO_SERIAL_PORT=

# Keep false until the HC-SR04 is wired to the Arduino UNO and the sketch is uploaded.
RUBBLEECHO_ULTRASONIC_ENABLED=false

RUBBLEECHO_HOST=0.0.0.0
RUBBLEECHO_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
