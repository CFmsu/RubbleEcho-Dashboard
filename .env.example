# Copy to .env and fill in locally. Never commit the filled file.

# Nebius Token Factory. Leave blank until the operator supplies a key.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Set this only after GET /v1/models shows an NVIDIA open-source model id.
NEBIUS_MODEL_ID=
NEBIUS_TIMEOUT_SECONDS=20
# Leave false until the key and model id are in this local file.
AI_ENABLED=false

# Local operator token for trial, knock, and motion requests. Not a Nebius key.
OPERATOR_TOKEN=

# Optional overrides. Hardware ports stay empty until wiring is verified.
RUBBLEECHO_DATA_DIR=
RUBBLEECHO_SERIAL_PORT=
RUBBLEECHO_PROBE_CAMERAS=0
